# Plantilla de configuracion local. Copie este archivo como .env (no se versiona)
# y reemplace los valores. Spring Boot lee .env al arrancar desde la raiz del proyecto;
# una variable de entorno con el mismo nombre tiene prioridad.

# Conexion de la aplicacion al esquema respaldos (contenedor oracle-xe, puerto 1522).
RESPALDOS_DB_URL=jdbc:oracle:thin:@//localhost:1522/XEPDB1
RESPALDOS_DB_USUARIO=respaldos
RESPALDOS_DB_CLAVE=cambiar

# Clave de SYS del contenedor (la usa la imagen gvenzl/oracle-xe al crearlo).
# La aplicacion no la usa: RMAN se conecta con "rman target /" dentro del contenedor.
ORACLE_PASSWORD=cambiar
